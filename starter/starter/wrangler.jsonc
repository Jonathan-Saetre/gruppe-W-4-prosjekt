{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Navnet på workeren, og subdomenet den får: <name>.workers.dev.
  "name": "webapp",
  "main": "src/worker.tsx",

  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": "public"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {},

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-db",
      "database_id": "__change_me__",
      "migrations_dir": "drizzle/migrations",
      "migrations_pattern": "drizzle/migrations/*/migration.sql"
    }
  ],

  // Durable Object for økter. Session-cookien signeres og lagres her,
  // ikke i D1. Navnet USER_SESSION_DO må matche bindingen i lib/session.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_SESSION_DO",
        "class_name": "UserSession"
      }
    ]
  },

  // Klasser med SQLite-backet storage må deklareres i en migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserSession"]
    }
  ]
}